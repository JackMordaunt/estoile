package journal

import "core:fmt"
import "core:strings"
import "core:testing"

// The service runs the root-owned copy with only fanotify's capabilities, and may
// write only its own folder.
@(test)
test_the_service_is_confined :: proc(t: ^testing.T) {
	unit := unit_text()
	lines := []string {
		"ExecStart=/usr/local/libexec/leita/leita journal run",
		"Restart=on-failure",
		"CapabilityBoundingSet=CAP_SYS_ADMIN CAP_DAC_READ_SEARCH",
		"AmbientCapabilities=CAP_SYS_ADMIN CAP_DAC_READ_SEARCH",
		"NoNewPrivileges=yes",
		"ProtectSystem=strict",
		"ReadWritePaths=/var/lib/leita",
		"WantedBy=multi-user.target",
	}
	for line in lines {
		testing.expectf(
			t,
			strings.contains(unit, fmt.tprintf("%s\n", line)),
			"no %q in:\n%s",
			line,
			unit,
		)
	}
	testing.expect(t, !strings.contains(unit, "ProtectHome="), "ProtectHome hides /home")
}

// The service a package installs is the one leita journal on would write, run
// from the package's copy: the file is generated by nothing, so this keeps it
// from drifting.
@(test)
test_the_packaged_service_is_the_same :: proc(t: ^testing.T) {
	packaged := #load("../packaging/linux/leita-journal.service", string)
	testing.expect_value(t, packaged, unit_text(PACKAGE_BINARY_PATH))
}
