[Unit]
Description=leita: record which folders change

[Service]
Type=simple
ExecStart=/usr/libexec/leita/leita journal run
Restart=on-failure
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_DAC_READ_SEARCH
AmbientCapabilities=CAP_SYS_ADMIN CAP_DAC_READ_SEARCH
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/leita
# Not ProtectHome: the recorder opens the folders that change to name them,
# and most of them are under /home.

[Install]
WantedBy=multi-user.target
