package search

// Latin_Fold is one row of LATIN: a letter, and the ASCII letter it folds to.
@(private)
Latin_Fold :: struct {
	from: u16,
	to:   u8,
}

// latin_base is the ASCII letter r folds to, as fzf folds it, or 0 when r is not
// one LATIN folds. A character outside the table's range is told so at once.
@(private)
latin_base :: proc(r: rune) -> u8 {
	if r < 0x00C0 || r > 0xFF61 {
		return 0
	}
	lo, hi := 0, len(LATIN)
	for lo < hi {
		mid := (lo + hi) / 2
		switch v := rune(LATIN[mid].from); {
		case v < r:
			lo = mid + 1
		case v > r:
			hi = mid
		case:
			return LATIN[mid].to
		}
	}
	return 0
}

/*
LATIN is fzf's table of Latin letters with diacritics and their base letters,
sorted by the letter folded (github.com/junegunn/fzf, src/algo/normalize.go, read
2026-10): é is e, Ü is U, ø is o, ß is s, and a fullwidth letter is its ASCII
one. It maps one character to one, as fzf's does, so a folded name keeps a
character for each of its own and its positions stay where they were.
*/
@(private, rodata)
LATIN := [?]Latin_Fold {
